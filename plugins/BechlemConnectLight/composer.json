{
    "name": "marks-software-gmbh/bechlem-connect-light-plugin",
    "description": "Bechlem GmbH CrossSellingData & Simple Tables REST API Version 1.2 and Product Connect Middleware for Free - A CakePHP 5 and PHP 8 powered Product Content Management System.",
    "license": "MIT",
    "type": "cakephp-plugin",
    "authors": [
        {
            "name": "Marks Software GmbH - Lukas Marks",
            "email": "info@marks-software.de",
            "homepage": "https://www.marks-software.de",
            "role": "Developer"
        }
    ],
    "keywords": ["pim", "cms", "cakephp", "cakephp5", "bootstrap", "adminlte", "php8", "content-management", "sqlite", "eav", "rest", "api"],
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-ftp": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "ext-zip": "*",
        "almasaeed2010/adminlte": "^3.2",
        "cakephp/authentication": "^4.2",
        "cakephp/authorization": "^3.0",
        "cakephp/cakephp": "5.4.*",
        "cakephp/migrations": "^5.0",
        "cakephp/plugin-installer": "^2.0",
        "dereuromark/cakephp-tinyauth": "^4.1",
        "firebase/php-jwt": "^7.2",
        "friendsofcake/bootstrap-ui": "^5.2",
        "friendsofcake/cakephp-csvview": "^5.1",
        "friendsofcake/crud": "^7.2",
        "friendsofcake/search": "^7.9",
        "intervention/image": "^4.4",
        "mobiledetect/mobiledetectlib": "^4.8.03",
        "phpoffice/phpspreadsheet": "^2.4.8",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "josegonzalez/dotenv": "^4.0",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "BechlemConnectLight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BechlemConnectLight\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
